# Copy to .env (`cp .env.example .env`). `pnpm dev` loads it automatically.
# Required variables have a value below; optional ones are commented out with
# their default. Every variable is validated at boot: a bad value fails fast
# with a message listing what is wrong.

# --- http ---------------------------------------------------------------
# NODE_ENV: development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
# Allowed origins, comma-separated. `*` allows any (fine for dev, narrow it in production).
CORS=*

# --- auth (see docs/auth.md) --------------------------------------------
# Signs our access tokens (HS256). At least 32 characters; generate with
#   openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-characters
# Lifetimes: <number><s|m|h|d>
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d
# OAuth client id of your app in Google Cloud Console: the ID token audience.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional comma-separated allowlist; when set, other emails get 403.
# ALLOWED_EMAILS=me@example.com,you@example.com

# --- postgres (pnpm db:up:postgres) -------------------------------------
# Needed when src/infra/db/index.ts points at ./postgres (default).
DATABASE_URL=postgres://docker:docker@localhost:5433/app

# --- mongo (pnpm db:up:mongo) -------------------------------------------
# Needed when src/infra/db/index.ts points at ./mongo. The replica set
# (`replicaSet=rs0`) is required for transactions; the compose file sets it up.
# MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0
# MONGODB_DB=app

# --- redis (optional cache; pnpm db:up:redis) ---------------------------
# Without REDIS_URL the app runs with no cache and /health does not report one.
# REDIS_URL=redis://localhost:6379

# --- tests (optional overrides; defaults match docker-compose.yml) ------
# Tests always use their own databases, never the ones above.
# TEST_DATABASE_URL=postgres://docker:docker@localhost:5433/app_test
# TEST_MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0
# TEST_REDIS_URL=redis://localhost:6379/15

{
  "name": "fastify-api-template",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:generate:push": "drizzle-kit generate && drizzle-kit push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/session": "^11.1.6",
    "@fastify/swagger": "^9.9.3",
    "@paralleldrive/cuid2": "2.2.2",
    "@scalar/fastify-api-reference": "^1.77.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "0.33.0",
    "fastify": "5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "postgres": "3.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.24.2",
    "tsdown": "^0.23.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}

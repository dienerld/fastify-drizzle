{
  "name": "fastify-api-template",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:postgres": "vitest run --project postgres",
    "test:mongo": "vitest run --project mongo",
    "test:redis": "vitest run --project redis",
    "test:all": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test:all",
    "check:fast": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up:postgres": "docker compose --profile postgres up -d --wait",
    "db:up:mongo": "docker compose --profile mongo up -d --wait",
    "db:up:redis": "docker compose --profile redis up -d --wait",
    "db:down": "docker compose --profile postgres --profile mongo --profile redis down",
    "db:generate": "drizzle-kit generate --config src/infra/db/postgres/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/infra/db/postgres/migrate.ts",
    "db:studio": "drizzle-kit studio --config src/infra/db/postgres/drizzle.config.ts",
    "db:indexes": "tsx --env-file-if-exists=.env src/infra/db/mongo/indexes.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/swagger": "^9.9.3",
    "@scalar/fastify-api-reference": "^1.77.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "mongoose": "^9.12.0",
    "postgres": "4.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "tsdown": "^0.23.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}

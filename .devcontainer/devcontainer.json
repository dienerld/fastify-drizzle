// Dev container: Node 24 + pnpm, with the databases from ../docker-compose.yml.
// No features and no external network: the only image is the Microsoft one
// below. Validate with `devcontainer read-configuration --workspace-folder .`
{
  "name": "Fastify API Template",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspaces/fastify-api-template",
  // Services started with the dev container. `app` is defined in
  // .devcontainer/docker-compose.yml; the others are the compose profiles of
  // ../docker-compose.yml (naming a service here starts it despite its
  // profile). Add "mongo" and/or "redis" when you need them.
  "runServices": ["app", "postgres"],
  "forwardPorts": [3333],
  // pnpm at the version pinned in package.json ("packageManager")
  "postCreateCommand": "npm install -g \"pnpm@$(node -p \"require('./package.json').packageManager.split('@')[1]\")\" && pnpm install && cp -n .env.example .env",
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "humao.rest-client"],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome"
      }
    }
  }
}
